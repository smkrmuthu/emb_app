# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.gemini
*.jpg
*.jpeg
*.png
# Real bill photos/PDFs used for local testing carry personal data — never commit
# them. Pre-existing tracked PDFs (e.g. ExplainMyBill_Phase1.pdf) are unaffected.
*.pdf
# ...except the app's own generated icon/splash assets, which are legitimate,
# non-personal, and need to be tracked for the native builds to work at all.
!resources/*.png
!public/icons/*.png
!ios/App/App/Assets.xcassets/**/*.png
!android/app/src/main/res/**/*.png

# Cloudflare Worker local state / secrets
.wrangler
worker/.dev.vars

.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Capacitor native projects — commit the Xcode/Android Studio project files
# themselves, but not their local build caches, dependency checkouts, or
# machine-specific config (regenerated by `pod install` / Gradle sync).
ios/App/Pods
ios/App/App.xcworkspace/xcuserdata
ios/App/*.xcodeproj/xcuserdata
ios/App/*.xcodeproj/project.xcworkspace/xcuserdata
android/.gradle
android/local.properties
android/app/build
android/build
android/captures
android/.idea
*.keystore
!debug.keystore
